{
  "name": "your-erp",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "build": "pnpm build:web",
    "lint": "pnpm lint:web",
    "typecheck": "pnpm typecheck:web",
    "install:web": "pnpm --dir apps/web install",
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "lint:web": "pnpm --dir apps/web lint",
    "typecheck:web": "pnpm --dir apps/web typecheck",
    "install:admin": "pnpm --dir apps/admin install",
    "dev:admin": "pnpm --dir apps/admin dev",
    "build:admin": "pnpm --dir apps/admin build",
    "lint:admin": "pnpm --dir apps/admin lint",
    "typecheck:admin": "pnpm --dir apps/admin typecheck",
    "install:app": "pnpm --dir apps/app install",
    "dev:app": "pnpm --dir apps/app dev",
    "android:app": "pnpm --dir apps/app android",
    "ios:app": "pnpm --dir apps/app ios",
    "web:app": "pnpm --dir apps/app web",
    "build:app": "pnpm --dir apps/app build",
    "lint:app": "pnpm --dir apps/app lint",
    "typecheck:app": "pnpm --dir apps/app typecheck",
    "dev:api": "cd apps/api && go run ./cmd/server",
    "test:api": "cd apps/api && go test ./...",
    "check:boundaries": "node tooling/scripts/check-app-boundaries.mjs",
    "test": "node --test tooling/scripts/check-app-boundaries.test.mjs"
  }
}
